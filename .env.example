# ==============================================================================
# Service Desk AI Assistant — Environment Variables Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: The system runs completely offline in G01. No Gemini API key or external
# services are required to start, test, or verify the system.
# ==============================================================================

# Application Metadata
APP_NAME="Service Desk AI Assistant"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# Backend Server & Networking
HOST="127.0.0.1"
PORT=8000
API_V1_PREFIX="/api"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Persistence / SQLite
# Defaults to a persistent local SQLite database file in the ./data directory.
DATABASE_URL="sqlite:///./data/service_desk.db"

# Gemini LLM Settings (GOAL 04)
# Kept server-side only; never exposed to the frontend bundle.
# GEMINI_API_KEY="your-api-key-here"
GEMINI_TRIAGE_MODEL="gemini-3.5-flash-lite"
GEMINI_DIAGNOSIS_MODEL="gemini-3.5-flash-lite"
GEMINI_FINALIZATION_MODEL="gemini-3.5-flash-lite"
GEMINI_TRIAGE_THINKING="medium"
GEMINI_DIAGNOSIS_THINKING="high"
GEMINI_FINALIZATION_THINKING="medium"
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
AGENT_CONTEXT_WINDOW_TURNS=10


# RAG / Knowledge Base Settings (GOAL 03)
KNOWLEDGE_BASE_DIR="knowledge_base"
CHROMA_PERSIST_DIR="./data/chroma_db"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.48
RAG_USE_FAKE_ENCODER=false


# Frontend Configuration (Vite)
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_API_URL="http://localhost:8000"
