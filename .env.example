# ==============================================================================
# Service Desk AI Assistant — Environment Variables Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: The system runs completely offline in G01. No Gemini API key or external
# services are required to start, test, or verify the system.
# ==============================================================================

# Application Metadata
APP_NAME="Service Desk AI Assistant"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# Backend Server & Networking
HOST="127.0.0.1"
PORT=8000
API_V1_PREFIX="/api"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Persistence / SQLite
# Defaults to a persistent local SQLite database file in the ./data directory.
DATABASE_URL="sqlite:///./data/service_desk.db"

# Gemini LLM Settings (Optional for G01)
# Kept server-side only; never exposed to the frontend bundle.
# GEMINI_API_KEY=""
GEMINI_TRIAGE_MODEL="gemini-2.5-flash"
GEMINI_DIAGNOSIS_MODEL="gemini-2.5-flash"
GEMINI_FINALIZATION_MODEL="gemini-2.5-flash"

# Frontend Configuration (Vite)
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_API_URL="http://localhost:8000"
